target/
# Isolated coverage/bench target dirs. `cargo llvm-cov` merges every
# `*.profraw` under one target dir, so a coverage run concurrent with another
# build must use its own. They are build output and must never be staged.
target-*/
Cargo.lock

# Java fixture generator build output (regenerated from fixtures/src/*.java)
fixtures/classes/

# Claude Code local settings (machine-specific). The skills symlink IS tracked.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Lucene jars downloaded by scripts/gen-fixtures.sh and verify-write-path.sh
fixtures/.jars/

# Benchmark corpus (gigabytes) and runner build output. The corpus is
# reproducible from scripts/bench-corpus.sh plus its manifest, so it is
# regenerated rather than stored.
benchmarks/.corpus/
# Raw benchmark run output; the numbers worth keeping are copied into
# docs/benchmarks/ with the environment they were measured in.
benchmarks/.results/
benchmarks/rust-runner/target/
benchmarks/rust-runner/Cargo.lock

# Python bytecode from the scripts/ gate checkers.
__pycache__/
*.pyc
