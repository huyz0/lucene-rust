# Compounding with flags, rules and checks.
SET UTF-8
TRY abcdefghijklmnopqrstuvwxyz
COMPOUNDMIN 2
COMPOUNDWORDMAX 3
COMPOUNDFLAG C
COMPOUNDBEGIN B
COMPOUNDMIDDLE M
COMPOUNDEND E
ONLYINCOMPOUND O
COMPOUNDPERMITFLAG P
COMPOUNDFORBIDFLAG F
CHECKCOMPOUNDDUP
CHECKCOMPOUNDREP
CHECKCOMPOUNDCASE
CHECKCOMPOUNDTRIPLE
SIMPLIFIEDTRIPLE
CHECKCOMPOUNDPATTERN 2
CHECKCOMPOUNDPATTERN o b
CHECKCOMPOUNDPATTERN 0/X 0/Y
REP 1
REP f ph
BREAK 2
BREAK -
BREAK ^-

SFX S Y 1
SFX S 0 s/P .

PFX U Y 1
PFX U 0 un/P .
